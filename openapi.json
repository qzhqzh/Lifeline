{
  "openapi": "3.1.0",
  "info": {
    "title": "Lifeline Control Plane API",
    "version": "0.1.0",
    "description": "Evidence-driven autonomous multi-project and multi-Agent control plane. Streamable HTTP MCP is exposed separately at /mcp."
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Direct Node service" },
    { "url": "http://localhost:8019", "description": "Docker Compose LAN entry" }
  ],
  "externalDocs": {
    "description": "Autonomous board policy, Agent scopes and recovery runbook",
    "url": "./docs/AUTONOMOUS_BOARD_OPERATIONS.md"
  },
  "paths": {
    "/api/health": { "get": { "summary": "Health check", "responses": { "200": { "description": "Healthy" } } } },
    "/api/dashboard": { "get": { "summary": "Portfolio dashboard", "responses": { "200": { "description": "Dashboard snapshot" } } } },
    "/api/portfolio/dispatch": {
      "get": {
        "summary": "Get derived project health, dynamic dispatch batches, capacity, reasons, and efficiency metrics",
        "responses": { "200": { "description": "Autonomous dispatch board" } }
      }
    },
    "/api/portfolio/reporting": {
      "get": {
        "summary": "Get project-level Agent contact, planning continuity, staleness, and review-backlog health",
        "responses": { "200": { "description": "Agent reporting health for every active project" } }
      }
    },
    "/api/portfolio/rebalance": {
      "post": {
        "summary": "Recalculate and audit dispatch decisions, release expired leases, and reconcile derived Phase status",
        "security": [{ "agentBearer": [] }],
        "parameters": [{ "in": "header", "name": "Idempotency-Key", "required": true, "schema": { "type": "string", "maxLength": 256 } }],
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RebalanceRequest" } } }
        },
        "responses": { "200": { "description": "Rebalanced autonomous dispatch board" }, "400": { "description": "Idempotency-Key missing or invalid" }, "401": { "description": "Agent token missing or invalid" }, "403": { "description": "Scope or LAN boundary rejected" }, "503": { "description": "Agent tokens are not configured" }, "422": { "description": "Invalid policy or timestamp" } }
      }
    },
    "/api/agent-runs/claim": {
      "post": {
        "summary": "Atomically claim one NEXT execution or independent review task with a bounded lease",
        "security": [{ "agentBearer": [] }],
        "parameters": [{ "in": "header", "name": "Idempotency-Key", "required": true, "schema": { "type": "string", "maxLength": 256 } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentClaimRequest" } } }
        },
        "responses": { "201": { "description": "Claim result; task is null when no matching slot is available" }, "400": { "description": "Idempotency-Key missing or invalid" }, "401": { "description": "Agent token missing or invalid" }, "403": { "description": "Scope, identity, or LAN boundary rejected" }, "503": { "description": "Agent tokens are not configured" }, "422": { "description": "Invalid claim filters or task contract" } }
      }
    },
    "/api/trajectory": {
      "get": {
        "summary": "Get real Agent completion intervals and portfolio coverage",
        "parameters": [{ "in": "query", "name": "window", "required": false, "schema": { "type": "string", "enum": ["24h", "7d", "30d"], "default": "7d" } }],
        "responses": { "200": { "description": "Trajectory snapshot" }, "422": { "description": "Invalid window" } }
      }
    },
    "/api/subscriptions/summary": {
      "get": { "summary": "Get subscription availability and freshness counts", "responses": { "200": { "description": "Subscription summary" } } }
    },
    "/api/subscriptions/accounts": {
      "get": { "summary": "List personal subscription accounts with their latest normalized snapshots", "responses": { "200": { "description": "Subscription accounts" } } }
    },
    "/api/subscriptions/accounts/{accountId}": {
      "patch": {
        "summary": "Update a subscription alias, stale threshold, or enabled state",
        "security": [{ "agentBearer": [] }],
        "parameters": [{ "in": "path", "name": "accountId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Updated account" }, "422": { "description": "Invalid account settings" } }
      }
    },
    "/api/subscriptions/accounts/{accountId}/history": {
      "get": {
        "summary": "Get hourly normalized subscription snapshots",
        "parameters": [
          { "in": "path", "name": "accountId", "required": true, "schema": { "type": "string" } },
          { "in": "query", "name": "window", "required": false, "schema": { "type": "string", "enum": ["7d", "30d", "90d"], "default": "7d" } }
        ],
        "responses": { "200": { "description": "Hourly snapshot history" }, "422": { "description": "Invalid window" } }
      }
    },
    "/api/subscriptions/pairing-token": {
      "post": { "summary": "Create a single-use ten-minute browser extension pairing token", "security": [{ "agentBearer": [] }], "responses": { "201": { "description": "Pairing token created" }, "401": { "description": "Management token missing or invalid" }, "403": { "description": "Same-origin or schedule:write boundary rejected" } } }
    },
    "/api/subscriptions/collectors/pair": {
      "post": { "summary": "Exchange a pairing token from a Chrome extension origin", "responses": { "201": { "description": "Collector paired" }, "422": { "description": "Invalid or expired pairing token" } } }
    },
    "/api/subscriptions/snapshots": {
      "post": { "summary": "Submit a normalized snapshot from a paired local collector", "responses": { "202": { "description": "Snapshot accepted or previous value preserved" }, "422": { "description": "Invalid snapshot, token, origin, or clock" } } }
    },
    "/api/subscriptions/collectors/{collectorId}": {
      "delete": {
        "summary": "Revoke a paired subscription collector",
        "security": [{ "agentBearer": [] }, { "collectorBearer": [] }],
        "parameters": [{ "in": "path", "name": "collectorId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Collector revoked" }, "404": { "description": "Collector not found" } }
      }
    },
    "/api/bootstrap/portfolio-v2": {
      "get": {
        "summary": "Get the current user's Portfolio V2 bootstrap capability",
        "responses": { "200": { "description": "Bootstrap availability and existing receipt metadata" } }
      },
      "post": {
        "summary": "Apply the Portfolio V2 template once for the current user",
        "parameters": [{ "in": "header", "name": "Idempotency-Key", "required": false, "schema": { "type": "string", "maxLength": 256 } }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "conflictResolution": { "type": "string", "enum": ["MERGE_EXISTING", "KEEP_EXISTING"] }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Previously applied receipt or a conflict that requires an explicit merge/keep decision" },
          "201": { "description": "Portfolio created or migrated and receipt persisted" },
          "422": { "description": "Invalid idempotency key" }
        }
      }
    },
    "/api/projects": {
      "get": { "summary": "List projects", "responses": { "200": { "description": "Project collection" } } },
      "post": { "summary": "Create project", "responses": { "201": { "description": "Created project" }, "422": { "description": "Invalid project" } } }
    },
    "/api/phases": {
      "post": {
        "summary": "Create a Phase from the web UI with human provenance",
        "parameters": [{ "in": "header", "name": "Idempotency-Key", "required": false, "schema": { "type": "string", "maxLength": 256 } }],
        "responses": { "201": { "description": "Created Phase" }, "422": { "description": "Invalid Phase" } }
      }
    },
    "/api/phases/{phaseId}": {
      "patch": {
        "summary": "Update a Phase title or goal with schedule-version concurrency control",
        "parameters": [
          { "in": "path", "name": "phaseId", "required": true, "schema": { "type": "string" } },
          { "in": "header", "name": "Idempotency-Key", "required": false, "schema": { "type": "string", "maxLength": 256 } }
        ],
        "responses": {
          "200": { "description": "Updated Phase" },
          "409": { "description": "scheduleVersion conflict" },
          "422": { "description": "Phase is locked or invalid" }
        }
      }
    },
    "/api/projects/{projectId}/schedule": {
      "get": {
        "summary": "Get the Phase to Task schedule for one project",
        "parameters": [{ "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Ordered project schedule and current scheduleVersion" }, "404": { "description": "Project not found" } }
      },
      "patch": {
        "summary": "Reorder all movable tasks inside one Phase",
        "parameters": [
          { "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } },
          { "in": "header", "name": "Idempotency-Key", "required": false, "schema": { "type": "string", "maxLength": 256 } }
        ],
        "responses": {
          "200": { "description": "Updated project schedule" },
          "409": { "description": "scheduleVersion conflict" },
          "422": { "description": "Invalid or incomplete task order" }
        }
      }
    },
    "/api/projects/{projectId}/canvas-session": {
      "get": {
        "summary": "Create a short-lived, project-scoped collaborative canvas session",
        "security": [{ "projectBearer": [] }],
        "parameters": [{ "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Project canvas session",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CanvasSession" } } }
          },
          "404": { "description": "Project not found" },
          "503": { "description": "Collaborative canvas is not configured or unavailable" }
        }
      }
    },
    "/api/projects/{projectId}/access-grants": {
      "get": {
        "summary": "List revocable project access grants without returning token material",
        "security": [{ "projectBearer": [] }],
        "parameters": [{ "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Access grant collection" }, "401": { "description": "Project access required" }, "403": { "description": "access:manage capability required" } }
      },
      "post": {
        "summary": "Create a revocable project access link; the plaintext token is returned once",
        "security": [{ "projectBearer": [] }],
        "parameters": [{ "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateProjectAccessGrant" } } } },
        "responses": { "201": { "description": "Access grant and one-time token" }, "403": { "description": "access:manage capability required" } }
      }
    },
    "/api/projects/{projectId}/access-grants/{grantId}": {
      "delete": {
        "summary": "Revoke a project access grant while preserving its audit record",
        "security": [{ "projectBearer": [] }],
        "parameters": [
          { "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } },
          { "in": "path", "name": "grantId", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Revoked grant" }, "403": { "description": "access:manage capability required" }, "404": { "description": "Grant not found" } }
      }
    },
    "/api/projects/{projectId}/canvas-context": {
      "get": {
        "summary": "Get client-safe project objects, canvas bindings, change proposals, and caller capabilities",
        "security": [{ "projectBearer": [] }],
        "parameters": [{ "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Canvas project context" }, "403": { "description": "Project scope rejected" } }
      }
    },
    "/api/projects/{projectId}/canvas-bindings": {
      "post": {
        "summary": "Bind a Phase or Task reference to the shared project canvas",
        "security": [{ "projectBearer": [] }],
        "parameters": [{ "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateCanvasBinding" } } } },
        "responses": { "201": { "description": "Idempotent canvas binding" }, "403": { "description": "canvas:bind capability required" } }
      }
    },
    "/api/projects/{projectId}/canvas-change-proposals": {
      "post": {
        "summary": "Propose a formal task-board move from the canvas without silently changing schedule state",
        "security": [{ "projectBearer": [] }],
        "parameters": [{ "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateCanvasChangeProposal" } } } },
        "responses": { "201": { "description": "Pending change proposal" }, "403": { "description": "canvas-change:create capability required" } }
      }
    },
    "/api/projects/{projectId}/canvas-change-proposals/{proposalId}": {
      "patch": {
        "summary": "Accept or dismiss a canvas change proposal; acceptance uses schedule-version concurrency control",
        "security": [{ "projectBearer": [] }],
        "parameters": [
          { "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } },
          { "in": "path", "name": "proposalId", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Reviewed proposal" }, "409": { "description": "Schedule version changed" }, "403": { "description": "canvas-change:review capability required" } }
      }
    },
    "/api/projects/{projectId}/test-map": {
      "get": {
        "summary": "Get the generated test catalog and scenario routes for one project",
        "security": [{ "projectBearer": [] }],
        "parameters": [{ "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Configured test map, or an explicit configured=false response for projects without an adapter" },
          "404": { "description": "Project not found" }
        }
      }
    },
    "/api/projects/{projectId}/test-scenario-proposals": {
      "get": {
        "summary": "List source-backed coverage gaps and Red-Green workflow state",
        "security": [{ "projectBearer": [] }],
        "parameters": [{ "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Scenario proposal collection without model or confidence metadata" } }
      },
      "post": {
        "summary": "Submit a source-backed semantic or deterministic scenario proposal without writing code or creating a Task",
        "security": [{ "projectBearer": [] }],
        "parameters": [{ "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } }],
        "responses": { "201": { "description": "Deduplicated scenario proposal" }, "422": { "description": "Source evidence missing or invalid" } }
      }
    },
    "/api/projects/{projectId}/test-scenario-proposals/{proposalId}": {
      "patch": {
        "summary": "Review, accept, dismiss, suppress, or reopen a test scenario proposal",
        "security": [{ "projectBearer": [] }],
        "parameters": [
          { "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } },
          { "in": "path", "name": "proposalId", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Updated workflow state" }, "422": { "description": "Invalid workflow transition" } }
      }
    },
    "/api/projects/{projectId}/test-scenario-proposals/{proposalId}/draft": {
      "post": {
        "summary": "Generate a minimal reviewed Node, pytest, or JUnit test skeleton without writing the repository",
        "security": [{ "projectBearer": [] }],
        "parameters": [
          { "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } },
          { "in": "path", "name": "proposalId", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "201": { "description": "Test draft" }, "422": { "description": "Scenario is not accepted" } }
      }
    },
    "/api/projects/{projectId}/test-scenario-proposals/{proposalId}/runs": {
      "post": {
        "summary": "Record baseline or implementation evidence; only matching RED evidence creates one implementation Task",
        "security": [{ "projectBearer": [] }],
        "parameters": [
          { "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } },
          { "in": "path", "name": "proposalId", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "201": { "description": "Scenario run evidence and resulting workflow state" }, "422": { "description": "Run or workflow state invalid" } }
      }
    },
    "/api/projects/{projectId}/test-scenario-proposals/{proposalId}/verify": {
      "post": {
        "summary": "Verify a GREEN scenario with deterministic evidence, independent review, or owner approval",
        "security": [{ "projectBearer": [] }],
        "parameters": [
          { "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } },
          { "in": "path", "name": "proposalId", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Verified scenario" }, "422": { "description": "Scenario is not GREEN" } }
      }
    },
    "/api/work-items": {
      "get": { "summary": "List work items", "responses": { "200": { "description": "Work item collection" } } },
      "post": { "summary": "Create planned work item with persistent human or Agent provenance", "responses": { "201": { "description": "Created work item" }, "422": { "description": "Invalid execution contract" } } }
    },
    "/api/work-items/{workItemId}": {
      "get": {
        "summary": "Get one work item",
        "parameters": [{ "in": "path", "name": "workItemId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Work item" }, "404": { "description": "Work item not found" } }
      },
      "patch": {
        "summary": "Edit an unfinished work item contract, move it between PLANNED and DEFERRED with a reason, or update only Issue metadata on locked history",
        "parameters": [
          { "in": "path", "name": "workItemId", "required": true, "schema": { "type": "string" } },
          { "in": "header", "name": "Idempotency-Key", "required": false, "schema": { "type": "string", "maxLength": 256 } }
        ],
        "responses": { "200": { "description": "Updated work item" }, "409": { "description": "scheduleVersion conflict" }, "422": { "description": "Task is locked or invalid" } }
      },
      "delete": {
        "summary": "Cancel an unstarted task while preserving audit history",
        "parameters": [
          { "in": "path", "name": "workItemId", "required": true, "schema": { "type": "string" } },
          { "in": "header", "name": "Idempotency-Key", "required": false, "schema": { "type": "string", "maxLength": 256 } }
        ],
        "responses": { "200": { "description": "Cancelled work item" }, "409": { "description": "scheduleVersion conflict" }, "422": { "description": "Task cannot be cancelled" } }
      }
    },
    "/api/work-items/{workItemId}/client-board": {
      "patch": {
        "summary": "Move an active task to any shared client-board status and feature swimlane",
        "parameters": [
          { "in": "path", "name": "workItemId", "required": true, "schema": { "type": "string" } },
          { "in": "header", "name": "Idempotency-Key", "required": false, "schema": { "type": "string", "maxLength": 256 } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["expectedScheduleVersion", "phaseId", "statusId"],
                "properties": {
                  "expectedScheduleVersion": { "type": "integer", "minimum": 0 },
                  "phaseId": { "type": "string" },
                  "statusId": { "type": "string", "enum": ["pending", "scheduled", "running", "review"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Moved task" },
          "409": { "description": "scheduleVersion conflict" },
          "422": { "description": "Task, phase, dependency, or status is not movable" }
        }
      }
    },
    "/api/work-items/{workItemId}/ready": {
      "post": {
        "summary": "Validate execution contract and mark ready",
        "parameters": [{ "in": "path", "name": "workItemId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Ready work item" }, "422": { "description": "Contract validation failed" } }
      }
    },
    "/api/work-items/{workItemId}/details": {
      "get": {
        "summary": "Get a task contract, current Run, CompletionRecords, Evidence, audit history and current dispatch decision",
        "parameters": [{ "in": "path", "name": "workItemId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Detailed task record" }, "404": { "description": "Task not found" } }
      }
    },
    "/api/work-items/{workItemId}/restore": {
      "post": {
        "summary": "Restore one cancelled task to PLANNED while preserving its cancellation and restoration audit history",
        "parameters": [
          { "in": "path", "name": "workItemId", "required": true, "schema": { "type": "string" } },
          { "in": "header", "name": "Idempotency-Key", "required": false, "schema": { "type": "string", "maxLength": 256 } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RestoreTaskRequest" } } }
        },
        "responses": { "200": { "description": "Restored task" }, "409": { "description": "scheduleVersion conflict" }, "422": { "description": "Task or dependency cannot be restored" } }
      }
    },
    "/api/work-items/{workItemId}/queue": {
      "post": {
        "summary": "Deprecated Mock execution endpoint",
        "parameters": [{ "in": "path", "name": "workItemId", "required": true, "schema": { "type": "string" } }],
        "responses": { "422": { "description": "Mock execution is disabled; report the real Agent result through MCP" } }
      }
    },
    "/api/runs/{runId}": {
      "get": {
        "summary": "Get run, events, and evidence",
        "parameters": [{ "in": "path", "name": "runId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Run details" } }
      }
    },
    "/api/runs/{runId}/lease": {
      "post": {
        "summary": "Extend an active Agent claim lease without adding heartbeat or progress events; total duration is capped at eight hours",
        "security": [{ "agentBearer": [] }],
        "parameters": [
          { "in": "path", "name": "runId", "required": true, "schema": { "type": "string" } },
          { "in": "header", "name": "Idempotency-Key", "required": true, "schema": { "type": "string", "maxLength": 256 } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExtendLeaseRequest" } } }
        },
        "responses": { "200": { "description": "Extended ClaimLease" }, "400": { "description": "Idempotency-Key missing or invalid" }, "401": { "description": "Agent token missing or invalid" }, "403": { "description": "Scope, identity, or LAN boundary rejected" }, "503": { "description": "Agent tokens are not configured" }, "422": { "description": "Lease is missing, expired, owned by another Agent, or reached the limit" } }
      }
    },
    "/api/runs/{runId}/stream": {
      "get": {
        "summary": "Stream run events over Server-Sent Events",
        "parameters": [{ "in": "path", "name": "runId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "text/event-stream" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "agentBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "LAN Agent token scoped to the requested mutation"
      },
      "projectBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Revocable token scoped to one project and one VIEWER, EDITOR, MANAGER, or OWNER role"
      },
      "collectorBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Paired browser extension collector token, valid only from its bound chrome-extension Origin"
      }
    },
    "schemas": {
      "DispatchPolicy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "executionSlots": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "high": { "type": "integer", "minimum": 0 },
              "medium": { "type": "integer", "minimum": 0 },
              "low": { "type": "integer", "minimum": 0 }
            }
          },
          "reviewSlots": { "type": "integer", "minimum": 0 },
          "maxConcurrentChangesPerProject": { "type": "integer", "minimum": 1 },
          "reviewRiskAfterMs": { "type": "number", "exclusiveMinimum": 0 },
          "stalledAfterMs": { "type": "number", "exclusiveMinimum": 0 }
        }
      },
      "RebalanceRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "now": { "type": "string", "format": "date-time" },
          "applyPhaseStatus": { "type": "boolean", "default": true },
          "policy": { "$ref": "#/components/schemas/DispatchPolicy" }
        }
      },
      "AgentClaimRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agentId", "modelRef"],
        "properties": {
          "mode": { "type": "string", "enum": ["EXECUTION", "REVIEW"], "default": "EXECUTION" },
          "agentId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "modelRef": { "type": "string", "minLength": 1, "maxLength": 240 },
          "executor": { "type": "string", "minLength": 1, "maxLength": 160 },
          "provider": { "type": "string", "minLength": 1, "maxLength": 160 },
          "modelSnapshot": { "type": "object" },
          "reasoningEffort": { "type": "string", "minLength": 1, "maxLength": 80 },
          "capabilities": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
          "computeClasses": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["low", "medium", "high"] } },
          "riskTiers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["low", "medium", "high", "critical"] } },
          "projectIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 3, "maxLength": 160 } }
        }
      },
      "ExtendLeaseRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agentId"],
        "properties": {
          "agentId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "extensionMinutes": { "type": "integer", "minimum": 1, "maximum": 480, "default": 30 }
        }
      },
      "RestoreTaskRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "expectedScheduleVersion"],
        "properties": {
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "expectedScheduleVersion": { "type": "integer", "minimum": 0 }
        }
      },
      "CanvasSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "boardId", "iframeUrl", "expiresAt", "permissions", "accessModel"],
        "properties": {
          "provider": { "type": "string", "enum": ["wbo"] },
          "boardId": { "type": "string" },
          "iframeUrl": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["canOpen", "canEdit", "canClear"],
            "properties": {
              "canOpen": { "type": "boolean" },
              "canEdit": { "type": "boolean" },
              "canClear": { "type": "boolean" }
            }
          },
          "accessModel": { "type": "string", "enum": ["project-rbac"] }
        }
      },
      "CreateProjectAccessGrant": {
        "type": "object",
        "additionalProperties": false,
        "required": ["displayName", "role"],
        "properties": {
          "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
          "organizationId": { "type": ["string", "null"], "maxLength": 160 },
          "subjectId": { "type": ["string", "null"], "maxLength": 160 },
          "role": { "type": "string", "enum": ["VIEWER", "EDITOR", "MANAGER", "OWNER"] },
          "expiresAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "CreateCanvasBinding": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entityType", "entityId"],
        "properties": {
          "entityType": { "type": "string", "enum": ["PHASE", "TASK"] },
          "entityId": { "type": "string" },
          "boardId": { "type": ["string", "null"] },
          "canvasObjectId": { "type": ["string", "null"] }
        }
      },
      "CreateCanvasChangeProposal": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workItemId", "targetPhaseId", "statusId", "reason"],
        "properties": {
          "workItemId": { "type": "string" },
          "targetPhaseId": { "type": "string" },
          "statusId": { "type": "string", "enum": ["pending", "scheduled", "running", "review"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  }
}
